# Reglas temporales para triggering.py
HIGH_LOAD_THRESHOLD=0.82
REQUIRED_CONSECUTIVE_WINDOWS=3
ARTIFACT_THRESHOLD=0.50
COOLDOWN_SECONDS=30

# Credencial local del tutor; nunca guardar una clave real en este archivo
OPENAI_API_KEY=

# Tutor OpenAI: desactivado salvo activación explícita
ENABLE_TUTOR=false
OPENAI_MODEL=gpt-4.1-mini

# TikTok/video: solo abrir después de una respuesta válida del tutor
OPEN_TIKTOK_ON_TRIGGER=false

# Artefactos locales de confianza; rutas relativas al directorio de ejecución
EEG_MODEL_PATH=./models/modelo_eeg_unicorn.pkl
# Dejar vacío solo si el modelo no requiere un escalador externo
EEG_SCALER_PATH=./models/escalador_eeg.pkl

# Pipeline EEG: defaults PROVISIONALES, no equivalencia demostrada al entrenamiento
EEG_SAMPLE_RATE=250
EEG_WINDOW_SECONDS=1
# Paso entre ventanas (1 s = sin solapamiento con el default anterior)
EEG_HOP_SECONDS=1
EEG_CHANNEL_COUNT=8
EEG_THETA_HZ=4,8
EEG_ALPHA_HZ=8,12
EEG_BETA_HZ=12,30
EEG_GAMMA_HZ=30,45
EEG_FILTER_ENABLED=true
EEG_FILTER_LOW_HZ=1
EEG_FILTER_HIGH_HZ=40
EEG_FILTER_ORDER=4
EEG_WELCH_NPERSEG=256
# Solapamiento interno de Welch; distinto del paso entre ventanas EEG
EEG_WELCH_OVERLAP=0.5
# as_acquired conserva referencia; common_average es una opción explícita
EEG_REFERENCE=as_acquired
# Declaración de unidades, SIN conversión: unconfirmed, uV o V
EEG_INPUT_UNITS=unconfirmed
# Calidad sobre señal cruda. 0 detecta canales exactamente constantes
EEG_FLATLINE_PTP=0
# Vacíos = desactivados; calibrar en las unidades reales antes de fijar límites
EEG_MAX_ABS=
EEG_MAX_STEP=

# Windows: carpeta Lib del SDK instalado, solo si UnicornPy/DLL no es accesible
UNICORN_PYTHON_PATH=
# Necesario si hay varios dispositivos; nunca se elige uno ambiguamente
UNICORN_SERIAL=
# Muestras por lectura SDK en UnicornSource; el smoke test siempre usa 25
UNICORN_FRAME_LENGTH=25
